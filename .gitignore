# Personal container config — keep out of the shared repo
platforms/*/Dockerfile.local
platforms/*/.claude/

# AI agent local overrides — user-specific, never committed
CLAUDE.local.md
AGENTS.local.md
.github/copilot-instructions.local.md

# Claude Code personal settings — project settings.json is committed
.claude/settings.local.json

platforms/*/vendor/*/build/
platforms/*/vendor/*/*.nds
platforms/*/vendor/*/*.gba

# ROM files
*.nes
*.sfc
*.smc
*.gb
*.gbc
*.gba
*.nds
*.gen
*.z64
*.n64
*.v64
*.iso
*.cue
*.img

# Save files
*.sav
*.dsv
*.srm

# Rust build artifacts
shim/target/

# Pre-built binaries (built inside Docker, not tracked)
shared/shim
