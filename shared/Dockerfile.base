FROM rust:latest AS builder
WORKDIR /build
COPY tsukumogami/ ./tsukumogami/
COPY protocol/ ./protocol/
COPY Cargo.toml ./
# Build only the tsukumogami (gami) binary for the container image
RUN cargo build --release -p tsukumogami

FROM ubuntu:latest

RUN apt update && apt upgrade -y

RUN apt install -y \
    bison \
    cmake \
    curl \
    flex \
    g++ \
    gdb-multiarch \
    git \
    make \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    python3-venv \
    ripgrep \
    tree \
    wget \
    xxd \
    xz-utils \
    zsh

COPY --from=builder /build/target/release/gami /usr/local/bin/gami
